#
# wm independent hotkeys
# 

# Interfaz de Flameshot
Print
    flameshot gui

# terminal emulator
super + Return
    kitty
# program launcher
super + d
	rofi -show drun -show-icons

# make sxhkd reload its configuration files:
super + shift + r
	pkill -USR1 -x sxhkd

#
# bspwm hotkeys
#

# Cambiar de vertical a Horizontal
super + e
    bspc node @parent -y next

# quit/restart bspwm
super + alt + {q,r}
	bspc {quit,wm -r}

# close and kill
super + {_,shift + }q
	bspc node -{c,k}


#
# state/flags
#

# set the window state
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# alternate between the tiled and monocle layout
super + space
	bspc desktop -l next


#
# focus/swap
#

super + {_,shift + }{Left,Down,Up,Right}
       bspc node -{f,s} {west,south,north,east}


# focus the last node/desktop
super + {grave,Tab}
	bspc {node,desktop} -f last

# focus or send to the given desktop
super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}'

#
# move/resize
#

# Expandir
super + ctrl + {Left,Down,Up,Right}  
      ~/.config/bspwm/scripts/bspwm_resize.sh expand {west,south,north,east} 50

# Contraer  
super + ctrl + alt + {Left,Down,Up,Right}
      ~/.config/bspwm/scripts/bspwm_resize.sh contract {west,south,north,east} 50


