XF86Audio{RaiseVolume,LowerVolume,Mute}
    ~/.config/polybar/scripts/Audio.sh --{inc,dec,toggle-mute} && polybar-msg action "#audio.hook.0"

XF86MonBrightnessUp
    brightnessctl set +5% && lightctl up

# Bajar brillo (5%)
XF86MonBrightnessDown
    brightnessctl set 5%- && lightctl down

# --- Control Multimedia ---
# Play/Pausa
XF86AudioPlay
    playerctl play-pause

# Siguiente
XF86AudioNext
    playerctl next

# Anterior
XF86AudioPrev
    playerctl previous

# --- Modo Avión (Multi-idioma) ---
XF86RFKill
    W_STATE=$(nmcli radio all | grep -q "disabled" && echo "on" || echo "off"); \
    nmcli radio all "$W_STATE"; \
    if [[ "$LANG" == es_* ]]; then \
        TITLE="Modo Avión"; MSG="Estado: $W_STATE"; \
    else \
        TITLE="Airplane Mode"; MSG="Status: $W_STATE"; \
    fi; \
    notify-send -u low -t 2000 -r 999 -i "airplane-mode" "$TITLE" "$MSG"


# Cambiar estado del monitor.
super + p
    ~/.config/bspwm/scripts/monitor/monitor_cycle.sh


# Power Menu (Rofi)
# Power Menu
super + Escape
     ~/.config/rofi/powermenu/powermenu.sh