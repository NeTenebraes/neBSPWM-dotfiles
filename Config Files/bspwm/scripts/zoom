#!/bin/sh

LOG="$HOME/.cache/bspwm-external-rules.log"

wid="$1"
class="$2"
instance="$3"
consequences="$4"

name() {
    xprop -id "$wid" WM_NAME _NET_WM_NAME 2>/dev/null | sed -n 's/.*= "\(.*\)"/\1/p' | head -n 1
}

mouse() {
    xdotool getmouselocation --shell 2>/dev/null
}

screen() {
    xrandr | awk '/\*/ {print $1; exit}'
}

center_rect() {
    size="$1"
    w="${size%x*}"
    h="${size#*x}"
    scr="$(screen)"
    sw="${scr%x*}"
    sh="${scr#*x}"
    x=$(( (sw - w) / 2 ))
    y=$(( (sh - h) / 2 ))
    [ "$x" -lt 0 ] && x=0
    [ "$y" -lt 0 ] && y=0
    printf '%sx%s+%s+%s' "$w" "$h" "$x" "$y"
}

hide_later() {
    (
        sleep 0.20
        xdotool windowunmap "$wid" 2>/dev/null
    ) &
}

n="$(name)"

mkdir -p "$(dirname "$LOG")"
printf '%s | wid=%s | class=%s | instance=%s | name=%s | consequences=%s\n' \
"$(date '+%F %T')" "$wid" "$class" "$instance" "$n" "$consequences" >> "$LOG"

case "$class:$instance:$n" in
    zoom:zoom:Meeting)
        echo "state=tiled sticky=off follow=on focus=on border=off"
        ;;

    zoom:zoom:Reunión*de*Zoom*|zoom:zoom:Zoom*Meeting*)
        rect="$(center_rect 638x512)"
        # Forzamos layer=normal para anular el STAYS_ON_TOP que mete Zoom por defecto
        echo "state=floating layer=normal sticky=off follow=on focus=on border=off rectangle=${rect}"
        ;;

    zoom:zoom:zoom_linux_float_video_window)
        echo "state=floating sticky=on follow=on focus=on border=off rectangle=270x100+20+20"
        ;;

    zoom:zoom:meeting\ bottombar\ popup)
        eval "$(mouse)"
        x=$(( X - 150 ))
        y=$(( Y - 260 ))
        [ "$x" -lt 0 ] && x=0
        [ "$y" -lt 0 ] && y=100
        echo "state=floating sticky=off follow=on focus=on border=off rectangle=300x257+${x}+${y}"
        ;;

    zoom:zoom:Toolbar\ Menu)
        eval "$(mouse)"
        x=$(( X - 150 ))
        y=$(( Y - 260 ))
        [ "$x" -lt 0 ] && x=0
        [ "$y" -lt 0 ] && y=0
        echo "state=floating sticky=off follow=on focus=on border=off rectangle=248x249+${x}+${y}"
        ;;

    zoom:zoom:Meeting\ chat)
        echo "state=floating sticky=off follow=off focus=off border=off rectangle=360x520+40+80"
        ;;

    zoom:zoom:annotate_toolbar)
        echo "manage=off focus=off follow=off state=floating layer=above border=off"
        ;;

    zoom:zoom:as_toolbar)
        echo "state=floating sticky=off follow=off focus=off manage=off border=off rectangle=967x86+20+20"
        ;;

    zoom:zoom:Zoom\ Workplace)
        echo "state=floating sticky=off follow=on focus=off border=off"
        ;;

    zoom:zoom:You\ are\ screen\ sharing)
        hide_later
        echo "state=floating sticky=off border=off"
        ;;

    zoom:zoom:Meeting\ security)
        echo "state=floating sticky=off follow=off focus=off manage=off layer=above border=off rectangle=420x209+473+279"
        ;;

    zoom:zoom:zoom)
        echo "state=floating sticky=off follow=on focus=on border=off"
        ;;
    zoom:zoom:Request*Zoom*AI)
        echo "state=floating layer=above sticky=off follow=off focus=off border=off"
        ;;
esac