#! /bin/sh

xrdb -merge ~/.Xresources
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# --- QT/THEME FIX ---
# Fuerza XCB para evitar bordes rotos en BSPWM y Kvantum para unificar temas
export QT_QPA_PLATFORM=xcb
export QT_STYLE_OVERRIDE=kvantum
export QT_QPA_PLATFORMTHEME=qt5ct
# Iniciar Portals necesarios para Qt6
(sleep 1; /usr/lib/xdg-desktop-portal &)
(sleep 1; /usr/lib/xdg-desktop-portal-gtk &)
# ------------------------------------------------

# --- Configuración del SSH-Agent ---

# Inicia el agente solo si no está corriendo.
pgrep -u "$USER" ssh-agent > /dev/null || ssh-agent -s > /tmp/ssh-agent.sh

# Carga las variables de entorno.
[ -f /tmp/ssh-agent.sh ] && . /tmp/ssh-agent.sh

# --- Configuración de las ventanas  ---
xsetroot -cursor_name left_ptr
bspc config border_width        2
bspc config window_gap          3
bspc config top_padding 		20

bspc config split_ratio          0.50
bspc config borderless_monocle   false
bspc config gapless_monocle      true

bspc config focus_follows_pointer true 

# --- Configuración de la tecla de acción ---
bspc config pointer_modifier mod4
bspc config pointer_action1 move
bspc config pointer_action2 resize_side

# ---  Reglas para ciertas ventanas ---

bspc rule -a MEGAsync state=floating rectangle=800x600+0+0 center=on sticky=on follow=on
bspc rule -a KeePassXC state=floating rectangle=1024x720+0+0 center=on sticky=on follow=on
bspc rule -a Nm-applet state=floating center=on
bspc rule -a Nm-connection-editor state=floating center=on

bspc rule -a Pavucontrol state=floating center=on
bspc rule -a Blueman-manager rectangle=800x600+0+0 state=floating center=on
bspc rule -a Pluma state=floating center=on
bspc rule -a mpv state=floating   
bspc rule -a VLC state=floating

bspc rule -a Nemo:nemo:"File conflict" state=floating rectangle=1000x500+183+134 center=on focus=on
bspc rule -a firefox rectangle=800x600+0+0 center=on focus=on


bspc rule -a Rofi state=floating center=on

# Essential Startup
pgrep picom >/dev/null || picom &
pgrep sxhkd >/dev/null || sxhkd &
#pgrep feh >/dev/null || feh --bg-fill ~/.config/bspwm/wallpaper.png &

#Support for custom startup
~/.config/bspwm/start.sh &

# Terminar np-applet y megasync si están corriendo
pgrep np-applet && pkill np-applet
pgrep megasync && pkill megasync

pgrep polkit-gnome-authentication-agent-1 && pkill polkit-gnome-authentication-agent-1

# Iniciar aplicaciones necesarias
pgrep nm-applet || nm-applet &
pgrep megasync || megasync &
pgrep keepassxc || keepassxc &
pgrep flameshot || flameshot &
pgrep polkit-gnome-authentication-agent-1 || /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
pgrep blueman-applet || blueman-applet &

# Desactiva el curso si no lo estás usando.
pgrep unclutter || unclutter -idle 5 -root &

# --- Lock screen & Power Management ---
# Bloqueo reactivo (Tapa/Suspensión manual)
# El flag --transfer-sleep-lock evita que se vea el escritorio al despertar
pgrep xss-lock || xss-lock --transfer-sleep-lock -- betterlockscreen -l blur &

# Bloqueo proactivo e Inactividad (Tu regla mejorada)
# 300s: Bloqueo | 600s: Pantalla off | 900s: Suspensión total
pgrep xidlehook || xidlehook \
  --not-when-fullscreen \
  --not-when-audio \
  --timer 300 'betterlockscreen -l blur' '' \
  --timer 600 'xset dpms force off' 'xset dpms force on' \
  --timer 900 'systemctl suspend' '' &

# --- Monitor watcher ---
pkill -f monitor_setup.sh
rm -f /tmp/monitor_current_state
(sleep 1; "$HOME/.config/bspwm/monitor_setup.sh") &