[global]
    font = JetBrainsMono Nerd Font 10

    # POSICIÓN (Sintaxis moderna)
    origin = bottom-right
    offset = (30, 30)

    # TAMAÑO (Sintaxis moderna)
    width = 450
    height = (0, 300)

    notification_limit = 5

    # COLORES
    frame_color = "#ff2a2a"
    separator_color = frame
    frame_width = 2
    highlight = "#ff2a2a"

    # ICONOS (Limpiado y forzado)
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true
    icon_position = left
    max_icon_size = 64
    # icon_path define rutas extras si el tema falla
    icon_path = /usr/share/icons/Papirus-Dark/48x48/status:/usr/share/icons/Papirus-Dark/48x48/devices:/usr/share/icons/Papirus-Dark/48x48/apps

    # ESPACIADO
    padding = 12
    horizontal_padding = 16
    text_icon_padding = 16

    # TEXTO
    markup = full
    format = "<b>%s</b>\n%b"
    ignore_newline = no
    corner_radius = 6
    transparency = 0

[urgency_low]
    background = "#0f0f0f"
    foreground = "#888888"
    timeout = 4

[urgency_normal]
    background = "#0f0f0f"
    foreground = "#ffffff"
    timeout = 8

[urgency_critical]
    background = "#300000"
    foreground = "#ffcccc"
    frame_color = "#ff0000"
    timeout = 0

# --- ETHERNET ESPECÍFICO ---
[nm-eth-connected]
    summary = "*onnection*stablished*"
    body = "*thernet*"
    new_icon = /usr/share/icons/Papirus-Dark/48x48/status/notification-network-ethernet-connected.svg

[nm-eth-disconnected]
    summary = "*isconnected*"
    body = "*thernet*"
    new_icon = /usr/share/icons/Papirus-Dark/48x48/status/notification-network-ethernet-disconnected.svg

# --- WI-FI ESPECÍFICO ---
[nm-wifi-connected]
    summary = "*onnected to*"
    new_icon = /usr/share/icons/Papirus-Dark/48x48/status/notification-network-wireless.svg

[nm-wifi-disconnected]
    summary = "*isconnected*"
    body = "*i-Fi*"
    new_icon = /usr/share/icons/Papirus-Dark/48x48/status/notification-network-wireless-disconnected.svg

[airplane-mode-rule]
    summary = "*Avi*"
    new_icon = /usr/share/icons/Papirus-Dark/48x48/status/airplane-mode.svg

[airplane-mode-en]
    summary = "Airplane Mode"
    new_icon = /usr/share/icons/Papirus-Dark/48x48/status/airplane-mode.svg