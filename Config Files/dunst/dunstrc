[global]
    font = JetBrainsMono Nerd Font 10

    show_indicators = no


    # POSICIÓN (Sintaxis moderna)
    origin = bottom-right
    offset = (30, 30)

    # TAMAÑO (Sintaxis moderna)
    width = 450
    height = (0, 300)

    notification_limit = 5

    # COLORES
    frame_color = "#ff2a2a"
    separator_color = frame
    frame_width = 2
    highlight = "#ff2a2a"

    # ICONOS (Limpiado y forzado)
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true
    icon_position = left
    max_icon_size = 64
    # icon_path define rutas extras si el tema falla
    icon_path = /usr/share/icons/Papirus-Dark/48x48/status:/usr/share/icons/Papirus-Dark/48x48/devices:/usr/share/icons/Papirus-Dark/48x48/apps

    # ESPACIADO
    padding = 12
    horizontal_padding = 16
    text_icon_padding = 16

    # TEXTO
    markup = full
    format = "<b>%s</b>\n%b"
    ignore_newline = no
    corner_radius = 6
    transparency = 0

[urgency_low]
    background = "#0f0f0f"
    foreground = "#888888"
    timeout = 4

[urgency_normal]
    background = "#0f0f0f"
    foreground = "#ffffff"
    timeout = 8

[urgency_critical]
    background = "#300000"
    foreground = "#ffcccc"
    frame_color = "#ff0000"
    timeout = 0

# ===============================
#  REGLAS DE RED (NETWORKMANAGER)
# ===============================

# --- ETHERNET CONECTADO ---
[nm-eth-connected]
    appname = "NetworkManager Applet"
    summary = "Connection Established"
    body = ".*Wired connection.*"
    new_icon = /usr/share/icons/Papirus-Dark/48x48/status/notification-network-ethernet-connected.svg

# --- ETHERNET ---
[nm-eth-connected]
    appname = "NetworkManager Applet"
    summary = "Connection Established"
    body = "*Wired connection*"
    new_icon = /usr/share/icons/Papirus-Dark/48x48/status/notification-network-ethernet-connected.svg

# --- WI-FI ---
[nm-wifi-connected]
    appname = "NetworkManager Applet"
    summary = "Connection Established"
    body = "*Wi-Fi network*"
    new_icon = /usr/share/icons/Papirus-Dark/48x48/status/notification-network-wireless.svg

# --- DESCONECTADO (Genérico) ---
[nm-disconnected]
    appname = "NetworkManager Applet"
    summary = "Disconnected"
    new_icon = /usr/share/icons/Papirus-Dark/48x48/status/notification-network-wireless-disconnected.svg
    
[airplane-mode-rule]
    summary = "*Avi*"
    new_icon = /usr/share/icons/Papirus-Dark/48x48/status/airplane-mode.svg

[airplane-mode-en]
    summary = "Airplane Mode"
    new_icon = /usr/share/icons/Papirus-Dark/48x48/status/airplane-mode.svg


# ==============================================================================
#  DEV NOTES & TROUBLESHOOTING LOG - NETWORKMANAGER VS DUNST
# ==============================================================================
#
#  ISSUE 01: "The Ghost Config"
#  SYMPTOM: Rules ignored, standard icons showing, theme errors (breeze-dark).
#  CAUSE: Dunst was loading a default config instead of ~/.config/dunst/dunstrc.
#  FIX: Ensure process is launched with 'dunst -conf ~/.config/dunst/dunstrc'.
#
#  ISSUE 02: "The Fancy Quote Trap"
#  SYMPTOM: Ethernet/WiFi rules not matching despite correct summary.
#  CAUSE: NetworkManager Applet sends body text with smart quotes (“...”) 
#         instead of standard ASCII quotes ("..."). 
#  FIX: Use wildcards (*) or POSIX regex (.*) to bypass specific characters.
#       Pattern: *Wired connection* matches “Wired connection 2”.
#
#  ISSUE 03: "Icon Hijacking"
#  SYMPTOM: Low-res or system-default icons appearing.
#  CAUSE: NM sends an 'icon' hint (nm-device-wired).
#  FIX: Use 'new_icon' in Dunst rules to force-override the client's hint
#       with the high-res Papirus-Dark SVG path.
#
#  DEBUG COMMANDS:
#  - Spy mode: killall dunst; dunst -print
#  - Test: notify-send -a "NetworkManager Applet" "Summary" "Body"
