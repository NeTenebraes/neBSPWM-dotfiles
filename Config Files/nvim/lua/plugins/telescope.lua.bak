-- =========================================================
-- Telescope: El buscador universal (Fuzzy Finder).
-- Permite buscar archivos, texto dentro de archivos, buffers 
-- abiertos y mucho más con una interfaz visual rápida.
-- Ahora incluye gestión de proyectos para acceso rápido.
-- =========================================================

return {
  {
    "nvim-telescope/telescope.nvim",
    dependencies = { 
      "nvim-lua/plenary.nvim", 
      "nvim-tree/nvim-web-devicons",
      -- Añadimos el motor de proyectos como dependencia
    },
    config = function()
      local telescope = require("telescope")

      telescope.setup({
        defaults = {
          layout_strategy = "vertical",   -- Vista previa arriba/abajo del buscador
          sorting_strategy = "ascending", -- Los resultados más relevantes aparecen arriba
          layout_config = { 
            width = 0.90, 
            height = 0.92, 
            prompt_position = "top"       -- La barra de escritura se sitúa arriba
          },
          prompt_prefix = "   ",         -- Icono de lupa en la búsqueda
          selection_caret = " ❯ ",        -- Icono que indica la selección actual
          path_display = { "smart" },     -- 'smart' es genial para ver el nombre del archivo primero
        },
      })
    end,
  },
}