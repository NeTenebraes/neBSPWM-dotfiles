-- =========================================================
-- Colorescheme: El tema visual principal.
-- Define la paleta de colores de la interfaz. Se carga con 
-- prioridad máxima para evitar el "parpadeo" de colores 
-- por defecto al iniciar el editor.
-- =========================================================

return {
  "dikiaap/minimalist",
  lazy = false,    -- No se puede cargar después; debe estar listo al abrir
  priority = 1000, -- Prioridad máxima para que cargue antes que otros plugins
  config = function()
    -- Intentar aplicar el tema Minimalist
    local ok = pcall(vim.cmd.colorscheme, "minimalist")
    
    -- Si el tema no está instalado o falla, usa 'habamax' como respaldo (fallback)
    if not ok then
      vim.cmd.colorscheme("habamax")
    end
    
    -- Carga la configuración lógica de colores (como tu archivo lua/theme.lua)
    local theme_ok, theme = pcall(require, "theme")
    if theme_ok then
      theme.setup()
    end
  end,
}